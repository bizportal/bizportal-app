{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/api-client-react": ["./src/shared/api-client-react/index.ts"],
      "@shared/object-storage-web": ["./src/shared/object-storage-web/index.ts"],
      "@shared/replit-auth-web": ["./src/shared/replit-auth-web/index.ts"],
      "@shared/product-templates": ["./src/shared/product-templates/index.ts"],
      "@shared/logistics-constants": ["./src/shared/logistics-constants/index.ts"]
    }
  }
}
